FROM node:lts-slim AS builder

LABEL maintainer="hello@tillertech.io"
LABEL org.opencontainers.image.source = "https://github.com/Tillertech/foundry"

# Which Angular app to build: "client" (the workspace app) or "client-portal".
ARG PROJECT=client

WORKDIR /foundry

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

RUN npm ci --legacy-peer-deps

COPY . .

ENV NX_DAEMON=false

# client-portal is reverse-proxied under /portal/ on the same domain as
# foundry-client (see nginx.conf's /portal/ location), so its build needs a
# matching base href for asset/script src
RUN if [ "$PROJECT" = "client-portal" ]; then \
      npx nx build $PROJECT --configuration=production --base-href=/portal/; \
    else \
      npx nx build $PROJECT --configuration=production; \
    fi

FROM nginx:alpine AS runner

LABEL maintainer="hello@tillertech.io"

ARG PROJECT=client

COPY nginx.conf /tmp/nginx.conf.client
COPY apps/client-portal/nginx.conf.template /tmp/nginx.conf.template.client-portal
RUN mkdir -p /etc/nginx/templates && \
    if [ "$PROJECT" = "client-portal" ]; then \
      rm -f /etc/nginx/conf.d/default.conf; \
      mv /tmp/nginx.conf.template.client-portal /etc/nginx/templates/default.conf.template; \
    else \
      mv /tmp/nginx.conf.client /etc/nginx/conf.d/default.conf; \
      rm -f /tmp/nginx.conf.template.client-portal; \
    fi

COPY --from=builder /foundry/dist/apps/${PROJECT}/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
