<!DOCTYPE html>
<html>
  <body style="margin:0;padding:0;background:#f4f4f5;font-family:Helvetica,Arial,sans-serif;color:#18181b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border-radius:8px;overflow:hidden;">
            <tr>
              <td style="padding:32px 40px;border-bottom:1px solid #e4e4e7;">
                <h1 style="margin:0;font-size:20px;">{{workspaceName}}</h1>
                <p style="margin:8px 0 0;color:#71717a;font-size:14px;">Milestone completed &middot; {{projectName}}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:32px 40px;">
                <p style="margin:0 0 16px;font-size:14px;">Hi {{clientName}},</p>
                <p style="margin:0 0 16px;font-size:14px;">
                  {{workspaceName}} completed a milestone on
                  <strong>{{projectName}}</strong>.
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">
                  <tr>
                    <td style="padding:14px 20px;">
                      <p style="margin:0;font-size:14px;font-weight:bold;color:#15803d;">&#10003; {{milestoneName}}</p>
                      {{#if milestoneDescription}}
                      <p style="margin:6px 0 0;font-size:13px;color:#3f3f46;">{{milestoneDescription}}</p>
                      {{/if}}
                      <p style="margin:6px 0 0;font-size:12px;color:#71717a;">Completed {{completedDate}}</p>
                    </td>
                  </tr>
                </table>
                {{#if hasProgress}}
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;border:1px solid #e4e4e7;border-radius:8px;">
                  <tr>
                    <td style="padding:16px 20px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                          <td style="font-size:13px;font-weight:bold;">Project progress</td>
                          <td style="text-align:right;font-size:18px;font-weight:bold;color:#ea580c;">{{progress}}%</td>
                        </tr>
                      </table>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:10px 0;background:#f4f4f5;border-radius:4px;">
                        <tr>
                          {{#if progress}}
                          <td width="{{progress}}%" style="height:8px;background:#f97316;border-radius:4px;font-size:0;line-height:0;">&nbsp;</td>
                          {{/if}}
                          {{#if remaining}}
                          <td width="{{remaining}}%" style="height:8px;font-size:0;line-height:0;">&nbsp;</td>
                          {{/if}}
                        </tr>
                      </table>
                      <p style="margin:0;font-size:12px;color:#71717a;">
                        {{completedMilestones}} of {{totalMilestones}} milestones complete{{#if nextMilestoneName}} &middot; Up next: <strong style="color:#18181b;">{{nextMilestoneName}}</strong>{{/if}}
                      </p>
                    </td>
                  </tr>
                </table>
                {{/if}}
                {{#if projectUrl}}
                <p style="margin:0;text-align:center;">
                  <a href="{{projectUrl}}" style="display:inline-block;padding:12px 28px;background:#18181b;color:#ffffff;border-radius:8px;font-size:14px;font-weight:600;text-decoration:none;">
                    View project
                  </a>
                </p>
                {{else}}
                <p style="margin:0;font-size:14px;">
                  Sign in to your client portal to see the full project
                  details.
                </p>
                {{/if}}
              </td>
            </tr>
            <tr>
              <td style="padding:24px 40px;background:#fafafa;border-top:1px solid #e4e4e7;">
                <p style="margin:0;font-size:12px;color:#a1a1aa;">
                  Sent by {{workspaceName}} via Foundry.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
