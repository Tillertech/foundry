generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum NotificationKind {
  invoice_sent
  invoice_paid
  invoice_partially_paid
  invoice_reminder
  quote_sent
  document_shared
  project_status_changed
  milestone_completed
}

enum Currency {
  USD
  EUR
  GBP
  KES
}

enum ClientStatus {
  active
  lead
  archived
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
}

enum MilestoneStatus {
  not_started
  in_progress
  completed
  on_hold
  cancelled
}

enum InvoiceStatus {
  draft
  sent
  viewed
  partially_paid
  paid
  overpaid
  overdue
  cancelled
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
}

enum PaymentMethod {
  card
  bank_transfer
  stripe
  paypal
  cash
  mobile_money
  other
}

enum ReconciliationKind {
  payment_applied
  payment_reversed
}

enum ExpenseCategory {
  software
  travel
  meals
  office
  marketing
  other
}

enum DocumentType {
  contract
  nda
  receipt
  report
  other
}

enum ClientPortalUserStatus {
  invited
  active
  suspended
}

model User {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String         @unique
  name            String
  passwordHash    String
  otpSecret       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspaces      Workspace[]
  notifications   Notification[]

  @@map("users")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       NotificationKind @default(invoice_sent)
  title      String
  body       String
  /// Id of the entity the notification points at (invoice, quote or document).
  resourceId String?          @db.Uuid
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Workspace {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String       @db.VarChar(500)
  /// Registered legal entity name, when it differs from the trading name.
  legalName          String?      @db.VarChar(500)
  slug               String       @db.VarChar(500)
  currency           Currency     @default(USD)
  city               String?      @db.VarChar(500)
  country            String?      @db.VarChar(500)
  email              String?      @db.VarChar(500)
  phone              String?      @db.VarChar(500)
  website            String?      @db.VarChar(500)
  address            String?      @db.VarChar(500)
  postCode           String?      @db.VarChar(500)
  taxCode            String?      @db.VarChar(500)
  // todo: carry workspace theme to client portal
  // theme              String?      @db.VarChar(150)
  invoicePrefix      String?
  quotePrefix        String?
  footerNote         String?
  /// Default tax rate (percent) applied to new invoices and quotes.
  taxRate            Decimal      @default(0) @db.Decimal(5, 2)
  paymentTerms       Int          @default(7)
  /// Storage key: local path in dev, S3 object key in prod.(logo)
  storageKey         String?
  status             ClientStatus @default(active)
  /// Invoice due-date reminder emails on/off for this workspace.
  remindersEnabled   Boolean      @default(false)
  /// How many days before the due date reminders start (also the re-send throttle).
  reminderDaysBefore Int          @default(3)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ownerId  String    @db.Uuid
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clients  Client[]
  /// Denormalized for the per-workspace invoice numbering sequence and its uniqueness constraint.
  invoices Invoice[]

  @@map("workspace")
}

model Client {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  company   String?
  // todo: add website
  currency  Currency     @default(USD)
  status    ClientStatus @default(active)
  phone     String?      @db.VarChar(250)
  taxId     String?
  address   String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projects     Project[]
  invoices     Invoice[]
  quotes       Quote[]
  payments     Payment[]
  documents    Document[]
  clientPortal ClientPortal?

  @@map("clients")
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  status      ProjectStatus @default(planning)
  budget      Decimal       @default(0) @db.Decimal(12, 2)
  hourlyRate  Decimal?      @db.Decimal(9, 2)
  startDate   DateTime
  endDate     DateTime?
  description String?

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invoices             Invoice[]
  expenses             Expense[]
  documents            Document[]
  reconciliations      ReconciliationEntry[]
  clientPortalProjects ClientPortalProject[]
  milestones           Milestone[]

  @@index([clientId])
  @@map("projects")
}

model Milestone {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  status         MilestoneStatus @default(not_started)
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Int?
  notes          String?
  /// Manual position within the project's milestone list (lower sorts first); reordered in whole-list swaps, not a priority ranking.
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("milestones")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String
  status         InvoiceStatus @default(draft)
  issueDate      DateTime
  dueDate        DateTime
  currency       Currency      @default(USD)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  /// Last time a due/overdue reminder email went out (reminder throttle).
  lastRemindedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  clientId    String    @db.Uuid
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?   @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  items           InvoiceItem[]
  payments        Payment[]
  reconciliations ReconciliationEntry[]

  @@unique([workspaceId, number])
  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  rate        Decimal @default(0) @db.Decimal(12, 2)

  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Billable expense this line re-bills to the client. Expense is only ever billed once;
  // quantity/rate are a snapshot of it: later edits or deletion of the expense never change an issued invoice.
  expenseId String?  @unique @db.Uuid
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Quote {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number     String      @unique
  status     QuoteStatus @default(draft)
  issueDate  DateTime
  validUntil DateTime
  currency   Currency    @default(USD)
  taxRate    Decimal     @default(0) @db.Decimal(5, 2)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  clientId String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  items QuoteItem[]

  @@index([clientId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  rate        Decimal @default(0) @db.Decimal(12, 2)

  quoteId String @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model Payment {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  currency  Currency      @default(USD)
  method    PaymentMethod @default(bank_transfer)
  reference String?
  date      DateTime
  notes     String?
  createdAt DateTime      @default(now())

  clientId  String   @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId String?  @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  reconciliations ReconciliationEntry[]

  @@index([clientId])
  @@map("payments")
}

/// Immutable ledger of how payments settle invoice and project balances.
/// An entry keeps both links so the same timeline is viewable from the
/// invoice, the project, or both.
model ReconciliationEntry {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           ReconciliationKind @default(payment_applied)
  /// Payment amount applied (positive) or reversed (negative).
  amount         Decimal            @db.Decimal(12, 2)
  currency       Currency           @default(USD)
  /// Amount still owed on the invoice after this entry.
  invoiceBalance Decimal?           @db.Decimal(12, 2)
  /// Project budget remaining after this entry (budget - payments received).
  projectBalance Decimal?           @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime           @default(now())

  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceId String?  @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([projectId])
  @@map("reconciliation_entries")
}

model Expense {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor   String
  category ExpenseCategory @default(other)
  amount   Decimal         @db.Decimal(12, 2)
  currency Currency        @default(USD)
  date     DateTime
  billable Boolean         @default(false)
  notes    String?

  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // invoice line this expense was billed on, if any.
  invoiceItem InvoiceItem?

  @@index([projectId])
  @@map("expenses")
}

model Document {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  type       DocumentType @default(other)
  /// Storage key: local path in dev, S3 object key in prod.
  storageKey String
  size       Int          @default(0)
  mimeType   String?
  notes      String?
  uploadedAt DateTime     @default(now())

  clientId  String?  @db.Uuid
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@map("documents")
}

model ClientPortal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  clientId  String   @unique @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  permission           PortalPermission?
  clientPortalProjects ClientPortalProject[]
  clientPortalUsers    ClientPortalUser[]

  @@map("clientPortal")
}

model ClientPortalUser {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  email           String
  passwordHash    String
  otpSecret       String?
  emailVerifiedAt DateTime?
  status          ClientPortalUserStatus @default(invited)

  clientPortalId String       @db.Uuid
  clientPortal   ClientPortal @relation(fields: [clientPortalId], references: [id], onDelete: Cascade)
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([email, clientPortalId])
  @@map("clientPortalUser")
}

model PortalPermission {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewProjects  Boolean  @default(true)
  viewDocuments Boolean  @default(true)
  viewQuotes    Boolean  @default(true)
  viewPayments  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  clientPortalId String       @unique @db.Uuid
  clientPortal   ClientPortal @relation(fields: [clientPortalId], references: [id], onDelete: Cascade)

  @@map("portalPermission")
}

model ClientPortalProject {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  clientPortalId String       @db.Uuid()
  clientPortal   ClientPortal @relation(fields: [clientPortalId], references: [id], onDelete: Cascade)
  projectId      String       @db.Uuid()
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientPortalId, projectId])
  @@map("clientPortalProject")
}
